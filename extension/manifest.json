{
  "manifest_version": 3,
  "name": "Command Click Rescue",
  "version": "0.1.0",
  "description": "Preserve Safari's native Command-click behavior on links.",
  "icons": {
    "128": "icon.svg"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["protect-links.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
