{
  "manifest_version": 3,
  "name": "Command Click Rescue",
  "version": "1.0.0",
  "description": "Preserve Safari's native Command-click behavior on links.",
  "icons": {
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png",
    "256": "icons/icon-256.png",
    "512": "icons/icon-512.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "protect-links.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
